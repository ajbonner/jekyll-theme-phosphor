source "https://rubygems.org"

# Local preview only — GitHub Pages does not consume this Gemfile.
# Pages builds the consumer site via actions/jekyll-build-pages@v1, which
# brings its own pinned `github-pages` gem. This Gemfile exists so a
# `bundle exec jekyll serve` from the theme repo (or from any consumer
# site that copies it) renders the theme on modern Ruby.

gem "jekyll", "~> 4.3"
gem "jekyll-remote-theme"
gem "jekyll-relative-links"
gem "jekyll-optional-front-matter"
gem "jekyll-readme-index"
gem "webrick"
